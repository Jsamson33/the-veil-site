{
	"hosting": {
		"public": "build",
		"ignore": ["firebase.json", "**/.*", "**/node_modules/**"],
		"predeploy": ["npm run build"],
		"headers": [
			{
				"source": "**/*.@(js|css|png|jpg|jpeg|gif|svg|webp|woff|woff2)",
				"headers": [
					{
						"key": "Cache-Control",
						"value": "public, max-age=31536000, immutable"
					}
				]
			},
			{
				"source": "**/*.html",
				"headers": [
					{
						"key": "Cache-Control",
						"value": "public, max-age=0, must-revalidate"
					}
				]
			}
		]
	}
}
